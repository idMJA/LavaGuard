    "lint:fix": "biome check --write --unsafe ./solver ./scripts build.ts"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "linkedom": "^0.18.13",
    "meriyah": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
